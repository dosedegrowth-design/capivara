# =========================================================================
# Capivara · Variaveis de ambiente
# Copiar para .env.local e preencher com valores reais.
# Nao comitar .env.local!
# =========================================================================

# ---- Supabase ----
# Capivara compartilha o projeto Supabase 'DDG' (mesmo do dash-supervisao).
# Schema dedicado: 'capivara' (configurado nos clients em src/lib/supabase/).
# IMPORTANTE: o schema 'capivara' precisa estar exposto na API REST do PostgREST.
#             Dashboard Supabase > Project Settings > API > "Exposed schemas" → adicionar 'capivara'
NEXT_PUBLIC_SUPABASE_URL=https://hkjukobqpjezhpxzplpj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_pCmZ2N_PRxtbgzMNbbxxSQ_EGFhRd_q
SUPABASE_SERVICE_ROLE_KEY=  # pegar em Dashboard > Project Settings > API > service_role secret

# ---- Asaas (pagamentos) ----
# https://www.asaas.com/api
ASAAS_API_KEY=
ASAAS_ENV=sandbox  # sandbox | production — NUNCA deixe vazio em prod
ASAAS_WEBHOOK_SECRET=  # gerar string aleatoria — Asaas envia em todos webhooks

# ---- API Full (consultas) ----
APIFULL_BASE_URL=https://api.apifull.com.br
APIFULL_API_KEY=

# ---- Resend (emails transacionais) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=Capivara <ola@suacapivara.com.br>

# ---- Secret interno pra rotas privilegiadas (Edge → webhook, refund, pdf) ----
# NOVO 2026-07-23 (audit): use dedicado, NUNCA reusar SERVICE_ROLE_KEY.
# Gerar com: openssl rand -hex 32
INTERNAL_WEBHOOK_SECRET=

# ---- Admin / Notificacoes ----
ADMIN_NOTIFICATION_EMAIL=lucas@dosedegrowth.com.br
ADMIN_NOTIFICATION_PHONE=  # opcional, para WhatsApp via Evolution API

# ---- Identidade da empresa (visivel publico) ----
# NOVO 2026-07-23 — substitui placeholders XX.XXX.XXX/0001-XX no LGPD, contato e footer.
NEXT_PUBLIC_CAPIVARA_CNPJ=  # ex: 12.345.678/0001-99
NEXT_PUBLIC_CAPIVARA_RAZAO_SOCIAL=Dose de Growth Marketing LTDA
NEXT_PUBLIC_CAPIVARA_WA_URL=  # ex: https://wa.me/5511999999999 (deixe vazio pra esconder canal)
NEXT_PUBLIC_CAPIVARA_TEL=  # ex: (11) 3000-0000 (deixe vazio pra esconder canal)
NEXT_PUBLIC_CAPIVARA_EMAIL=contato@suacapivara.com.br

# ---- Misc ----
NEXT_PUBLIC_SITE_URL=https://suacapivara.com.br  # ou http://localhost:3000 em dev

# ---- Plausible Analytics (opcional, LGPD-clean) ----
# Setar o dominio cadastrado em plausible.io (ex: "suacapivara.com.br").
# Quando vazio/ausente, o script nao carrega (no-op em dev).
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=suacapivara.com.br
